{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/"],
      "startServerCommand": "npx serve dist -l 4173",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:pwa": ["error", { "minScore": 0.9 }],
        "works-offline": "error",
        "installable-manifest": "error",
        "splash-screen": "warn",
        "themed-omnibox": "warn",
        "content-width": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
