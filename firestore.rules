rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ─── CHARACTER DATA (Decks, Cards) ───────────────────────────────────────
    // Cards are the app's data source for every user (read-only in the UI).
    // Writes are gated only by the in-app admin code (Remote Config
    // admin_code) — add Firebase Auth custom claims before public deploy.
    match /decks/{deckId} {
      allow read, write: if true;
    }
    match /cards/{cardId} {
      allow read, write: if true;
    }

    // ─── USER DATA (Progress) ────────────────────────────────────────────────
    // Anonymous device identity (UUID) acts as the bearer token.
    // Users can read/write to their own device path.
    match /devices/{deviceId} {
      allow read, write: if true;

      match /progress/{progressId} {
        allow read, write: if true;
      }
    }
  }
}
